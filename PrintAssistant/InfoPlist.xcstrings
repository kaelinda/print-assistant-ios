    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于扫描文档、身份证和拍摄证件照。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to scan documents, copy ID cards, and take ID photos."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于选择需要转换、识别或排版的图片。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to choose photos to convert, recognize, or lay out."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于将生成的文件或图片保存到照片。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to save generated files and images to Photos."
          }
        }
      }

    "PDF 中的证件外框按 ID‑1 标准尺寸生成。最终纸面尺寸仍需打印时选择 100% / 实际大小，并以真机打印验证为准。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF 中的证件外框按 ID‑1 标准尺寸生成。最终纸面尺寸仍需打印时选择 100% / 实际大小，并以真机打印验证为准。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ID frame in the PDF uses the ID-1 size. When printing, choose 100% / actual size, and confirm the result on a real printer."
          }
        }
      }
    },
